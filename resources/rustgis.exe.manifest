<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <!--
    激活 Common Controls v6（ComCtl32.dll 6.0.0.0）：
    1. 使 rfd 的 common-controls-v6 后端（TaskDialogIndirect）可用，
       "保存更改？"系统提示框因此能显示自定义按钮文案；
    2. 顺带让本进程的标准控件采用 Windows 视觉样式。
  -->
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*"/>
    </dependentAssembly>
  </dependency>
</assembly>
